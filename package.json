{
  "author": "Gonzalez",
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "description": "DSH 独立抖音插件：自主浏览、内容筛选、互动额度强制控制、白名单分享与安全熔断",
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-rc.2 <0.3.0-0",
    "node": ">=22.13"
  },
  "exports": {
    ".": "./dsh-plugin.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-plugin.mjs",
    "client.js",
    "cordis.bundle.yml",
    "lib/",
    "settings/",
    "integrations/",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "douyin",
    "browser-automation"
  ],
  "license": "MIT",
  "main": "dsh-plugin.mjs",
  "name": "dsh-douyin-gonzalez",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaoxj59/dsh-douyin-gonzalez.git"
  },
  "homepage": "https://github.com/zhaoxj59/dsh-douyin-gonzalez",
  "bugs": {
    "url": "https://github.com/zhaoxj59/dsh-douyin-gonzalez/issues"
  },
  "os": [
    "win32"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "selfcheck": "node selfcheck.mjs",
    "settings": "node settings/settings-server.mjs",
    "test": "node selfcheck.mjs"
  },
  "type": "module",
  "version": "0.4.0"
}
